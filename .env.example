# Botchain Mainnet RPC Configuration
BOTCHAIN_RPC_URL=https://rpc.botchain.ai
NEXT_PUBLIC_BOTCHAIN_RPC_URL=https://rpc.botchain.ai

# Deployer Private Key (Without 0x prefix or with 0x prefix, e.g. 0xabcdef...)
